#
# Birdhouse Vision - Samba Configuration Example
#
# This is an example smb.conf configuration for the NAS Pi.
# Copy the [birdhouse] and [birdhouse-guest] sections to your /etc/samba/smb.conf
#
# Setup steps:
#   1. sudo apt install samba samba-common-bin
#   2. sudo cp /etc/samba/smb.conf /etc/samba/smb.conf.backup
#   3. Add the sections below to /etc/samba/smb.conf
#   4. sudo smbpasswd -a birdhouse
#   5. sudo systemctl restart smbd nmbd
#   6. sudo systemctl enable smbd nmbd
#
# Test with: smbclient -L localhost -U birdhouse

#======================= Global Settings =======================
# These are typically already in your smb.conf - adjust as needed

[global]
   workgroup = WORKGROUP
   server string = Birdhouse NAS
   
   # Security settings
   security = user
   map to guest = Bad User
   
   # Logging
   log file = /var/log/samba/log.%m
   max log size = 1000
   logging = file
   
   # Performance tuning for Raspberry Pi
   socket options = TCP_NODELAY IPTOS_LOWDELAY
   read raw = yes
   write raw = yes
   max xmit = 65535
   dead time = 15
   getwd cache = yes

#======================= Birdhouse Shares =======================

# Authenticated share - Full read/write access for birdhouse user
# Connect with: smb://birdhouse-nas.local/birdhouse (macOS)
#               \\birdhouse-nas.local\birdhouse (Windows)
[birdhouse]
   comment = Birdhouse Captures (Authenticated)
   path = /mnt/birdhouse/captures
   browseable = yes
   read only = no
   writable = yes
   valid users = birdhouse
   create mask = 0644
   directory mask = 0755
   force user = birdhouse
   force group = birdhouse

# Guest share - Read-only access for anyone on the network
# Connect with: smb://birdhouse-nas.local/birdhouse-guest (macOS)
#               \\birdhouse-nas.local\birdhouse-guest (Windows)
# No password required - great for sharing with family
[birdhouse-guest]
   comment = Birdhouse Captures (Guest Read-Only)
   path = /mnt/birdhouse/captures
   browseable = yes
   read only = yes
   guest ok = yes
   guest only = yes
   force user = nobody
   force group = nogroup

#======================= Optional: Logs Share =======================
# Uncomment if you want to expose logs via Samba

